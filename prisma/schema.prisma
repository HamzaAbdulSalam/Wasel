// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model for authentication
model User {
  id        Int     @id @default(autoincrement())
  username  String  @unique
  email     String  @unique
  password  String
  role      String  @default("user")
  createdAt DateTime @default(now())
  
  // Relations
  incidents     RoadIncident[]
  statusHistories IncidentStatus[]
}

// Road Incident model
model RoadIncident {
  id          Int     @id @default(autoincrement())
  title       String
  description String
  type        String  // closure, delay, accident, weather_hazard, etc.
  severity    String  @default("medium") // low, medium, high, critical
  status      String  @default("active") // active, verified, resolved, closed
  
  // Location data
  city        String
  latitude    Decimal @db.Decimal(10, 8)
  longitude   Decimal @db.Decimal(11, 8)
  
  // User who created the incident
  userId      Int
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Status history
  statusHistories IncidentStatus[]
  
  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([city])
  @@index([status])
  @@index([userId])
}

// Incident Status History for tracking changes
model IncidentStatus {
  id          Int     @id @default(autoincrement())
  
  // Reference to incident
  incidentId  Int
  incident    RoadIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  
  // Status details
  previousStatus String
  newStatus      String
  reason         String?
  
  // User who changed the status
  userId      Int
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Metadata
  createdAt   DateTime @default(now())
  
  @@index([incidentId])
  @@index([userId])
}
